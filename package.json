{
  "name": "@okteto-website/docs",
  "version": "3.1.1",
  "private": true,
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/plugin-client-redirects": "^3.10.0",
    "@docusaurus/plugin-content-pages": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@docusaurus/theme-mermaid": "^3.10.0",
    "@mdx-js/react": "^3.1.1",
    "@sanity/client": "^7.21.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "classnames": "^2.3.1",
    "docusaurus-gtm-plugin": "^0.0.2",
    "docusaurus-plugin-sass": "^0.2.6",
    "lodash.trimend": "^4.5.1",
    "mixpanel-browser": "^2.84.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sass": "^1.99.0"
  },
  "engines": {
    "node": ">=22.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "start": "yarn develop",
    "develop": "docusaurus start --host 0.0.0.0 --port 8080 --no-open",
    "develop:blog": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-blog docusaurus start --config docusaurus.blog.config.js --host 0.0.0.0 --port 8081 --no-open",
    "build": "yarn build:docs && yarn build:blog",
    "build:docs": "docusaurus build --out-dir='build/docs' && mv build/docs/sitemap.xml build/docs/sitemap-docs.xml && node scripts/generate-all-llms-files.js",
    "build:blog": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-blog docusaurus build --config docusaurus.blog.config.js --out-dir build/blog && node scripts/blog-migrate/verify-urls.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "serve": "docusaurus serve --host 0.0.0.0 --port 8080",
    "clean": "docusaurus clear && DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-blog docusaurus clear --config docusaurus.blog.config.js",
    "docs": "docusaurus docs:version previous",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.20",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0"
  }
}
